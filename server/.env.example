# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Security ─────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_strong_random_secret
ART_TOKEN_SECRET=replace_with_strong_random_secret

# ─── Admin credentials ────────────────────────────────────────────────────────
ADMIN_LOGIN=admin
# bcrypt hash - generate with: node src/hash-password.js
ADMIN_PASS=change_me

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CLIENT_ORIGIN=http://localhost:3000

# ─── Documentation site ───────────────────────────────────────────────────────
# Hostname that serves docs/ instead of the radio client, on the same service.
# Leave empty to serve documentation on any host whose first label is "docs".
DOCS_HOST=

# ─── Radio schedule ─────────────────────────────────────────────────────────────
TIME_ZONE=Europe/Kyiv
DAY_START_HOUR=6
NIGHT_START_HOUR=0

# ─── Lyrics ───────────────────────────────────────────────────────────────────
# Lyrics come from LRCLIB, which needs no account or key.
# true = look up every uncached track at startup; false = fetch on demand only.
LYRICS_PREFETCH=false

# ─── Radio modes ──────────────────────────────────────────────────────────────
# false = client-side sync (default); true = server-side FFmpeg HTTP stream
STREAM_MODE=false
# false = day mode only (24/7); true = day/night schedule
NIGHT_MODE=true
# Live hosts / guest room / mic mixing (requires STREAM_MODE=true)
RADIO_HOSTS_MODE=false

# ─── Live hosts (RADIO_HOSTS_MODE=true only) ──────────────────────────────────
# Max simultaneous live participants (hosts + guests)
MAX_LIVE_HOST_SLOTS=1
# WebRTC host-monitor ICE UDP port range (open on firewall in production)
HOST_MONITOR_ICE_PORT_MIN=40000
HOST_MONITOR_ICE_PORT_MAX=40099
HOST_MONITOR_STUN_URL=stun:stun.l.google.com:19302

# ─── Database ─────────────────────────────────────────────────────────────────
# Local file DB: file:./yourbase.db
# Remote Turso:  libsql://your-db.turso.io
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ─── Data source ──────────────────────────────────────────────────────────────
# json = JSON files in server/; sql = Turso/libSQL
# A local "file:./data/sql/radio.db" needs no auth token; remote URLs do.
DATA_PROVIDER=json

# ─── Storage durability ───────────────────────────────────────────────────────
# Set to true when the host wipes its filesystem on every deploy or restart
# (typical of container platforms). The server still starts either way; it just
# warns and disables the admin actions whose result would not survive a restart,
# instead of silently losing it. A local file database counts as local disk,
# same as json.
EPHEMERAL_STORAGE=false

# ─── Media storage ────────────────────────────────────────────────────────────
# local = audio streamed through server; cloud = presigned URLs from Cloudflare R2
# MUSIC_SOURCE is accepted as a backward-compatible alias for MEDIA_STORAGE
MEDIA_STORAGE=local
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_PUBLIC_BASE_URL=
R2_PRESIGN_TTL_S=900
R2_ARTS_PREFIX=arts

# ─── Local library reconciliation (MEDIA_STORAGE=local only) ─────────────────
# On every start, the server scans local media folders and adds tracks/jingles/
# background music/arts found on disk but missing from the data store. It never
# does this for MEDIA_STORAGE=cloud - listing a bucket costs real requests, so
# reconciling cloud storage stays a manual "node scripts/migrate.js scan" step.
# The one destructive direction - a track whose file disappeared from disk - is
# never removed automatically either; set this to true to actually let it purge
# those stale records, otherwise it just warns and keeps them.
CONFIRM_TRACK_CLEANUP=false

# ─── Streaming (STREAM_MODE=true only) ────────────────────────────────────────
# Path to FFmpeg binary (also used for YouTube download in admin panel)
FFMPEG_PATH=ffmpeg

# ─── YouTube import (admin panel) ──────────────────────────────────────────────
# Needs FFMPEG_PATH above, plus python3 with:
#   pip install -r server/src/tools/ytbdown/requirements.txt
# YTBDOWN_PATH is only needed if the bundled server/src/bin/ytbdown wrapper
# isn't found automatically - leave empty otherwise.
YTBDOWN_PATH=

# ─── Audit log ────────────────────────────────────────────────────────────────
LOG_RETENTION_DAYS=7
LOG_PURGE_HOUR=4

# ─── Donations ────────────────────────────────────────────────────────────────
DONATIONS_ENABLED=false
# liqpay / stripe / donatello / kofi - only one active at a time
DONATIONS_PROVIDER=

# liqpay and stripe create a checkout session for the exact price and confirm
# it instantly by webhook - they need a registered business (FOP) to receive payouts.
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# This server's own public origin, used to build the LiqPay webhook callback URL
PUBLIC_SERVER_URL=

# donatello and kofi need no registered business - the donor pays on the
# creator's own fixed page and types a confirmation code in their comment,
# which the server matches back to the pending order (poll for Donatello,
# webhook for Ko-fi). Less exact than liqpay/stripe: the donor can mistype
# the code or the amount.
DONATELLO_API_TOKEN=
DONATELLO_PAGE_URL=https://donatello.to/your_page
DONATELLO_POLL_INTERVAL_S=30
KOFI_VERIFICATION_TOKEN=
KOFI_PAGE_URL=https://ko-fi.com/your_page

# How long a code-matching donation (donatello/kofi) stays pending before it
# expires unconfirmed (minutes, 3-60)
DONATION_MATCH_EXPIRY_MIN=15
# How long paid donations stay in the admin history (days, 7-3650)
DONATION_RETENTION_DAYS=365
